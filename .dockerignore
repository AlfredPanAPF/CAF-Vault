spike/corpus/raw/
spike/corpus/text/
spike/corpus/manifest.jsonl
spike/out/
spike/eval/

# GLEIF golden copy — ~1.3GB combined; fetched at runtime into the volume
spike/corpus/ref/gleif.sqlite
spike/corpus/ref/gleif_lei2.csv.zip
*.mp3
*.m4a
